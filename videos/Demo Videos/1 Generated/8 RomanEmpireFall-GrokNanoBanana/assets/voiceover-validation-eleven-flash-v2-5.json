    "sentences": [
      {
        "startMs": 0,
        "text": "Rome did not fall in one dramatic night."
      },
      {
        "startMs": 2427,
        "text": "It slowly forgot how to keep itself together."
      },
      {
        "startMs": 4888,
        "text": "Emperors changed so fast, the crown became a weapon."
      },
      {
        "startMs": 8324,
        "text": "Generals learned armies could make rulers, then unmake them."
      },
      {
        "startMs": 12086,
        "text": "Taxes rose, coins weakened, and cities began feeling abandoned."
      },
      {
        "startMs": 16370,
        "text": "Along the frontiers, pressure grew from hungry moving peoples."
      },
      {
        "startMs": 20004,
        "text": "Rome hired outsiders to defend borders it could not hold."
      },
      {
        "startMs": 23243,
        "text": "Some became allies; others saw power running out of answers."
      },
      {
        "startMs": 27260,
        "text": "In 378, Gothic fighters shattered a Roman army at Adrianople."
      },
      {
        "startMs": 31567,
        "text": "After that, fear started outrunning imperial orders."
      },
      {
        "startMs": 34888,
        "text": "In 410, Alaric entered Rome and shocked the world."
      },
      {
        "startMs": 38208,
        "text": "The city survived, but the myth of invincibility cracked."
      },
      {
        "startMs": 41505,
        "text": "Provinces broke away, taking grain, taxes, and soldiers with them."
      },
      {
        "startMs": 45731,
        "text": "By 476, the western emperor was easier to remove than rescue."
      },
      {
        "startMs": 50514,
        "text": "Constantinople endured, but in the West, Rome became a memory."
      },
      {
        "startMs": 54531,
        "text": "The fall was not one collapse, but a long surrender of trust."
      }
    ]
  }
